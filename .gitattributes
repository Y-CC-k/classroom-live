# 行尾統一：LF（CI 的 ESLint/prettier 要求；避免 runner autocrlf 造成差異）
* text=auto

*.ts  text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.js  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows 專用格式保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二進位
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.node binary
*.exe binary
*.zip binary

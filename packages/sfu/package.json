{
  "name": "@classroom/sfu",
  "version": "0.1.0",
  "private": true,
  "description": "SFU 媒體伺服器：mediasoup worker + router，用於教室廣播轉發",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "mediasoup": "^3.15.2",
    "@classroom/protocol": "*"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
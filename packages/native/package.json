    "rebuild": "electron-rebuild -f -w @classroom/native",
    "clean": "node-gyp clean"
  },
  "dependencies": {
    "node-addon-api": "^8.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "node-gyp": "^11.4.2"
  }
}
